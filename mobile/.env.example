# Copy to .env and fill in with your own Supabase project's values
# (Project Settings > API in the Supabase dashboard). Without these set,
# the app runs entirely on mock auth and sample challenge data — see
# README.md "The backend (Supabase)".
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
